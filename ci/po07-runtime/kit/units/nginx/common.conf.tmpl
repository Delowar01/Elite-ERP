# ---- PO-07 staging @HOST@ (fictional data only) — the part of the server block this kit owns ----------------------
# Pasted by the owner INSIDE the CloudPanel-generated server block, after every generated line that is kept (listen,
# server_name, certificate, logs, Basic Auth, the scheme redirect) and in place of every generated location block except
# CloudPanel's /.well-known handling. Rendered by tools/render-vhost.sh; the CI rehearsal includes this same text.
server_tokens off;
add_header X-Robots-Tag "noindex, nofollow" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
client_max_body_size @MAXBODY@;
# Path traversal and encoded dots, slashes or backslashes in the path: refused before anything else (400).
if ($request_uri ~* "^[^?]*(/\.\./|/\.\.$|%2e|%2f|%5c)") { return 400; }
# Every header the application trusts is set here; nothing a client sends in these headers is passed on.
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host "@HOST@";
proxy_set_header X-Forwarded-Host "@HOST@";
proxy_set_header X-Forwarded-Proto "https";
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header Forwarded "";
proxy_set_header X-Forwarded-Server "";
proxy_set_header X-Forwarded-Port "";
proxy_set_header X-Forwarded-Prefix "";
proxy_set_header X-Original-URL "";
proxy_set_header X-Rewrite-URL "";
proxy_set_header X-Middleware-Subrequest "";
proxy_set_header Authorization "";          # the staging Basic Auth credentials never reach the application
proxy_set_header Proxy "";
proxy_connect_timeout 5s;
proxy_read_timeout 60s;
location = /robots.txt { auth_basic off; default_type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
