# PO-07 staging — plan §B.1. admin process, fictional data only. Never touches the live ERP.
[Unit]
Description=PO staging - Platform Owner console (fictional data only)
Requires=elite-po-staging-netns.service postgresql@16-po07ns.service
After=elite-po-staging-netns.service postgresql@16-po07ns.service
StartLimitIntervalSec=300
StartLimitBurst=5
[Service]
Type=simple
User=po07app
Group=po07app
Slice=elite-po-staging.slice
NetworkNamespacePath=/run/netns/po07ns
WorkingDirectory=/srv/elite-po-staging/app
EnvironmentFile=/etc/elite-po-staging/admin.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 13310
Restart=on-failure
# next start exits 143 (128 + SIGTERM) when stopped: a clean stop, not a failure (no failed unit left on the host)
SuccessExitStatus=143
RestartSec=5s
MemoryHigh=448M
MemoryMax=512M
CPUQuota=40%
TasksMax=128
LimitNOFILE=4096
# --- sandbox (identical in every staging unit and in elite-po-run: units/sandbox.inc) ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
UMask=0077
TemporaryFileSystem=/run:ro /srv:ro /var/www:ro /opt:ro /var/backups:ro /var/spool:ro /var/lib:ro
# allow-list view (plan §B.1)
BindReadOnlyPaths=/srv/elite-po-staging/app /opt/google
# The whole build is read-only (decision J1, 23 Nov 2026): no writable path anywhere in the code tree, so no cache
# state is shared between the two processes; Next.js keeps its response cache in this process's memory.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=elite-po-admin
LogRateLimitIntervalSec=30s
LogRateLimitBurst=1000
[Install]
WantedBy=multi-user.target
