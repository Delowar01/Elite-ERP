const h16 = (s: string) => createHash("sha256").update(s).digest("hex").slice(0, 16);

/** A file's text with ACC-01's hunks undone — main's text when they are its only change; any other file as it is. */
export function undoAcc01(file: string, text: string): string {
  return (ACC01_EDITS[file] ?? []).reduce((acc, [was, is]) => acc.replace(is, () => was), text);
}

/**
 * The ACC-01 files that are NOT exactly main's plus their recorded hunks, and the added files that are not as recorded.
 * `actual` reads a repository file as it is on disk (null when it does not exist).
 */
export function acc01Drift(actual: (file: string) => string | null): string[] {
  const drift: string[] = [];
  for (const [f, hunks] of Object.entries(ACC01_EDITS)) {
    const src = actual(f);
    if (src === null || !hunks.every(([was, is]) => src.split(is).length === 2 && !src.includes(was)) || h16(undoAcc01(f, src)) !== ACC01_BASE_SHA[f]) drift.push(f);
  }
  for (const [f, sha] of Object.entries(ACC01_NEW)) {
    const src = actual(f);
    if (src === null || h16(src) !== sha) drift.push(`new: ${f}`);
  }
  return drift;
}
