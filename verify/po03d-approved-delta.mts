const h16 = (s: string) => createHash("sha256").update(s).digest("hex").slice(0, 16);

/** A file's text with the PO-03D hunks undone — 8c21044's text when they are its only change; any other file as it is. */
export function undoPo03d(file: string, text: string): string {
  return (PO03D_EDITS[file] ?? []).reduce((acc, [was, is]) => acc.replace(is, () => was), text);
}
/** Files whose bytes are not 8c21044's plus exactly the recorded hunks, and added files not as recorded. */
export function po03dDrift(actual: (file: string) => string | null): string[] {
  const drift: string[] = [];
  for (const [f, hunks] of Object.entries(PO03D_EDITS)) {
    const src = actual(f);
    if (src === null || !hunks.every(([was, is]) => src.split(is).length === 2 && !src.includes(was)) || h16(undoPo03d(f, src)) !== PO03D_BASE_SHA[f]) drift.push(f);
  }
  for (const [f, sha] of Object.entries(PO03D_NEW)) {
    const src = actual(f);
    if (src === null || h16(src) !== sha) drift.push(`new: ${f}`);
  }
  return drift;
}
