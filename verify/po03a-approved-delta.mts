const h16 = (s: string) => createHash("sha256").update(s).digest("hex").slice(0, 16);

/** A file's text with the PO-03A hunks undone — 1d036d6's text when they are its only change; any other file as it is. */
export function undoPo03a(file: string, text: string): string {
  return (PO03A_EDITS[file] ?? []).reduce((acc, [was, is]) => acc.replace(is, () => was), text);
}
/** Files whose bytes are not 1d036d6's plus exactly the recorded hunks, and added files not as recorded. */
export function po03aDrift(actual: (file: string) => string | null): string[] {
  const drift: string[] = [];
  for (const [f, hunks] of Object.entries(PO03A_EDITS)) {
    const src = actual(f);
    if (src === null || !hunks.every(([was, is]) => src.split(is).length === 2 && !src.includes(was)) || h16(undoPo03a(f, src)) !== PO03A_BASE_SHA[f]) drift.push(f);
  }
  for (const [f, sha] of Object.entries(PO03A_NEW)) {
    const src = actual(f);
    if (src === null || h16(src) !== sha) drift.push(`new: ${f}`);
  }
  return drift;
}
