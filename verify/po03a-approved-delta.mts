    ["import { PO02D3_BASE, PO02D3_EDITS, PO02D3_NEW, po02d3Drift, undoPo02d3 } from \"./po02d3-approved-delta.mjs\";\nimport { renderToStaticMarkup } from \"react-dom/server\";\n\n",
