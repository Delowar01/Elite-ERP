/**
 * Platform Owner PO-02D2 — a SEPARATE process for verify:platform-invitations (#11): it shares nothing with the suite but
 * the database, so a refusal here proves the hourly invitation limit is read from committed rows, never from process
 * memory. Inputs come from the environment (a TEST-ONLY token and password generated by the suite; never printed) and it
 * prints exactly one line: `OUTCOME <OK | code>`.
 */
const { platformClock } = await import("../../src/lib/platform/clock");
platformClock.now = () => new Date(Number(process.env.PO02D2_NOW));
const actions = await import("../../src/lib/platform/invitation-actions");
const { pool } = await import("../../src/db");
const host = process.env.PO02D2_HOST ?? "";
const headers = new Headers({ host, origin: `https://${host}`, "sec-fetch-site": "same-origin", "user-agent": "verify-platform-invitations-child", "x-forwarded-for": process.env.PO02D2_IP ?? "" });
const outcome = await actions.createCompanyInvitation(
  { headers, token: process.env.PO02D2_TOKEN ?? null },
  {
    companyName: "Fixture Child Process Co",
    industry: "",
    companyEmail: "child@company-fixture.test",
    country: "Saudi Arabia",
    currency: "SAR",
    ownerName: "Child Process Owner",
    ownerEmail: "child.owner@company-fixture.test",
    confirmDuplicateName: false,
    password: process.env.PO02D2_PASSWORD ?? "",
    totpCode: "000000",
  },
);
console.log(`OUTCOME ${outcome.ok ? "OK" : outcome.code}`);
await pool.end();
process.exit(0);
