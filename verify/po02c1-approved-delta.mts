function byPath(pairs: [string, string][]): Record<string, string> {
  return Object.fromEntries(pairs.map(([sha, file]) => [file, sha]));
}
/** ea94337's bytes of each changed file (sha256, 16 hex) — what the file is once its hunks are undone. */
export const PO02C1_BASE_SHA: Record<string, string> = byPath([
