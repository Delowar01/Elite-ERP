]);
/** The files PO-02C.1 added under src/ (sha256, 16 hex) — none. */
export const PO02C1_NEW: Record<string, string> = byPath([
]);

const h16 = (s: string) => createHash("sha256").update(s).digest("hex").slice(0, 16);

/** A file's text with the PO-02C.1 hunks undone — ea94337's text when they are its only change; any other file as it is. */
export function undoPo02c1(file: string, text: string): string {
  return (PO02C1_EDITS[file] ?? []).reduce((acc, [was, is]) => acc.replace(is, () => was), text);
}
/** Files whose bytes are not ea94337's plus exactly the recorded hunks, and added files not as recorded. */
export function po02c1Drift(actual: (file: string) => string | null): string[] {
  const drift: string[] = [];
  for (const [f, hunks] of Object.entries(PO02C1_EDITS)) {
    const src = actual(f);
    if (src === null || !hunks.every(([was, is]) => src.split(is).length === 2 && !src.includes(was)) || h16(undoPo02c1(f, src)) !== PO02C1_BASE_SHA[f]) drift.push(f);
  }
  for (const [f, sha] of Object.entries(PO02C1_NEW)) {
    const src = actual(f);
    if (src === null || h16(src) !== sha) drift.push(`new: ${f}`);
  }
  return drift;
}
