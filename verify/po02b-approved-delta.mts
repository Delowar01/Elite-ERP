  "verify/verify-page-archetypes.mts": [
    ["import { PO02A_BASE, PO02A_EDITS, PO02A_NEW, po02aDrift, undoPo02a } from \"./po02a-approved-delta.mjs\";\nimport { renderToStaticMarkup } from \"react-dom/server\";\n",
