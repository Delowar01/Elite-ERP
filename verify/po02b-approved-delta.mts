  ["ffce07e9bb80dd36", "src/lib/platform/companies.ts"],
  ["d5fe2033794a7ba5", "src/lib/platform/display.ts"],
]);

const h16 = (s: string) => createHash("sha256").update(s).digest("hex").slice(0, 16);

/** A file's text with the PO-02B hunks undone — 2a5674a's text when they are its only change; any other file as it is. */
export function undoPo02b(file: string, text: string): string {
  return (PO02B_EDITS[file] ?? []).reduce((acc, [was, is]) => acc.replace(is, () => was), text);
}
/** Files whose bytes are not 2a5674a's plus exactly the recorded hunks, and added files not as recorded. */
export function po02bDrift(actual: (file: string) => string | null): string[] {
  const drift: string[] = [];
  for (const [f, hunks] of Object.entries(PO02B_EDITS)) {
    const src = actual(f);
    if (src === null || !hunks.every(([was, is]) => src.split(is).length === 2 && !src.includes(was)) || h16(undoPo02b(f, src)) !== PO02B_BASE_SHA[f]) drift.push(f);
  }
  for (const [f, sha] of Object.entries(PO02B_NEW)) {
    const src = actual(f);
    if (src === null || h16(src) !== sha) drift.push(`new: ${f}`);
  }
  return drift;
}
