function byPath(pairs: [string, string][]): Record<string, string> {
  return Object.fromEntries(pairs.map(([sha, file]) => [file, sha]));
}
/** 2a5674a's bytes of each changed file (sha256, 16 hex) — what the file is once its hunks are undone. */
export const PO02B_BASE_SHA: Record<string, string> = byPath([
  ["03551e4300237e3f", "src/lib/platform/guards.ts"],
  ["2a617fb9dbd72616", "src/components/platform/i18n.ts"],
  ["dd089910b894c787", "src/app/(platform)/platform.css"],
  ["2ced9f620ba7bcc1", "src/app/(platform)/platform/(console)/companies/page.tsx"],
