ll-company { min-width: 12rem; max-width: 22rem; }\n.platform-cell-owner { min-width: 12rem; }\n.platform-cell-sub.platform-email { white-space: nowrap; }\n.platform-record-fields .platform-cell-sub.platform-email { white-space: normal; overflow-wrap: anywhere; }\n.platform-record-fields .platform-record-wide { grid-column: 1 / -1; }\n.platform-access { display: inline-flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); }\n.platform-access-note { font-size: var(--text-caption); line-height: var(--text-caption--line-height); color: var(--ink-muted); }\n.platform-record-cards { display: none; list-style: none; margin: 0; padding: 0; flex-direction: column; gap: var(--space-12); }\n.platform-record-card { display: flex; flex-direction: column; gap: var(--space-12); padding: var(--space-16); }\n.platform-record-head { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--space-12); }\n.platform-record-title { font-weight: 600; color: var(--ink); overflow-wrap: anywhere; }\n.platform-record-fields { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-12) var(--space-16); }\n.platform-record-fields dt { font-size: var(--text-caption); line-height: var(--text-caption--line-height); color: var(--ink-muted); }\n.platform-record-fields dd { margin: var(--space-2) 0 0; font-size: var(--text-body); line-height: var(--text-body--line-height); color: var(--ink); overflow-wrap: anywhere; }\n\n/* Keyset pagination: first / previous / next as links. */\n.platform-pager { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-12); }\n.platform-pager-summary { margin: 0; font-size: var(--text-body-sm); line-height: var(--text-body-sm--line-height); color: var(--ink-muted); }\n.platform-pager-links { display: flex; flex-wrap: wrap; gap: var(--space-8); }\n.platform-pager-link {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--space-6);\n  height: var(--control-height);\n  padding-inline: var(--space-12);\n  border-radius: 6px;\n  border: 1px solid var(--border);\n  background: var(--surface);\n  color: var(--ink);\n  font-size: var(--text-body);\n  font-weight: 500;\n  text-decoration: none;\n}\na.platform-pager-link:hover { border-color: var(--border-strong); background: var(--surface-subtle); }\na.platform-pager-link:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }\n.platform-pager-link[aria-disabled=\"true\"] { background: var(--disabled-background); color: var(--disabled-text); cursor: not-allowed; }\n\n/* Company detail. */\n.platform-breadcrumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); font-size: var(--text-body-sm); line-height: var(--text-body-sm--line-height); color: var(--ink-muted); }\n.platform-breadcrumbs li { display: inline-flex; align-items: center; gap: var(--space-6); min-width: 0; }\n.platform-breadcrumbs a { color: var(--ink-muted); text-decoration: none; }\n.platform-breadcrumbs a:hover { color: var(--ink); text-decoration: underline; }\n.platform-breadcrumbs a:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 2px; }\n.platform-breadcrumbs [aria-current=\"page\"] { color: var(--ink); font-weight: 500; overflow-wrap: anywhere; }\n.platform-company-tabs .tab-row { margin-bottom: var(--space-16); }\n.platform-detail-card { padding: var(--space-20); }\n.platform-detail-actions { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-8); }\n.platform-owner-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }\n.platform-owner { display: flex; flex-direction: column; padding-block: var(--space-12); }\n.platform-owner + .platform-owner { border-block-start: 1px solid var(--border); }\n.platform-owner-name { font-weight: 500; color: var(--ink); overflow-wrap: anywhere; }\n.platform-callout.platform-callout-inset { margin: var(--space-16) var(--space-16) 0; }\n.platform-subhead { margin: 0 0 var(--space-8); font-size: var(--text-body); line-height: var(--text-body--line-height); font-weight: 600; color: var(--ink); }\n.platform-newest { list-style: none; margin: 0 0 var(--space-12); padding: 0; display: flex; flex-direction: column; }\n.platform-newest li { padding-block: var(--space-8); }\n.platform-newest li + li { border-block-start: 1px solid var(--border); }\n\n/* Monthly registrations: one series in the brand orange (dark mode steps it toward the surface so it\n   stays inside the validated lightness band); bars ≤ 24px, 4px rounded data end, single baseline. */\n.platform-bars { list-style: none; margin: 0; padding: 0; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: var(--space-8); align-items: end; }\n.platform-bar-item { display: flex; flex-direction: column; align-items: center; gap: var(--space-4); min-width: 0; }\n.platform-bar-value { font-size: var(--text-body-sm); line-height: var(--text-body-sm--line-height); font-weight: 600; color: var(--ink); }\n.platform-bar-track { display: flex; align-items: flex-end; justify-content: center; inline-size: 100%; block-size: 120px; border-block-end: 1px solid var(--border); }\n.platform-bar {\n  inline-size: min(24px, 60%);\n  border-start-start-radius: 4px;\n  border-start-end-radius: 4px;\n  background: light-dark(var(--accent), color-mix(in oklab, var(--accent) 85%, var(--surface)));\n  color: var(--primary-foreground);\n}\n.platform-bar[data-zero] { block-size: 0; }\n.platform-bar-label { font-size: var(--text-caption); line-height: var(--text-caption--line-height); color: var(--ink-muted); text-align: center; overflow-wrap: anywhere; }\n\n@media (max-width: 1279.98px) {\n  .platform-stat-grid.platform-stat-quad { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n@media (max-width: 767.98px) {\n  .platform-stat-quad .platform-stat { padding: var(--space-16)