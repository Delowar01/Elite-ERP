    const src = actual(f);
    if (src === null || !hunks.every(([was, is]) => src.split(is).length === 2 && !src.includes(was)) || h16(undoPo02d1a1(f, src)) !== PO02D1A1_BASE_SHA[f]) drift.push(f);
  }
  for (const [f, sha] of Object.entries(PO02D1A1_NEW)) {
    const src = actual(f);
    if (src === null || h16(src) !== sha) drift.push(`new: ${f}`);
  }
  return drift;
}
