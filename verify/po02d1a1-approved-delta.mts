const h16 = (s: string) => createHash("sha256").update(s).digest("hex").slice(0, 16);

/** A file's text with the PO-02D1A.1 hunks undone — 43b0611's text when they are its only change; any other file as it is. */
export function undoPo02d1a1(file: string, text: string): string {
  return (PO02D1A1_EDITS[file] ?? []).reduce((acc, [was, is]) => acc.replace(is, () => was), text);
}
