  "src/lib/platform/guards.ts": [
    ["// transaction — src/lib/platform/invitation-actions.ts). It grants no acceptance and no customer data.\nexport const PLATFORM_PERMISSIONS = [\"platform.access\", \"platform.sessions.manage\", \"platform.mfa.manage\", \"platform.companies.read\", \"platform.companies.manage_access\", \"platform.companies.invite\"] as const;\nexport type PlatformPermission = (typeof PLATFORM_PERMISSIONS)[number];\n",
      "// transaction — src/lib/platform/invitation-actions.ts). It grants no acceptance and no customer data.\n// PO-03B: platform.users.read — the customer-user directory and the audited user detail (allow-listed fields only;\n// src/lib/platform/customer-users.ts). platform.users.manage — disable / enable a customer user and revoke a customer\n// user's sessions, always with a reason and a fresh TOTP code, under the shared customer-user lock order and owner\n// rules, audited in the same transaction (src/lib/platform/customer-user-actions.ts). Neither grants impersonation,\n// password resets, role changes or ownership transfer.\nexport const PLATFORM_PERMISSIONS = [\"platform.access\", \"platform.sessions.manage\", \"platform.mfa.manage\", \"platform.companies.read\", \"platform.companies.manage_access\", \"platform.companies.invite\", \"platform.users.read\", \"platform.users.manage\"] as const;\nexport type PlatformPermission = (typeof PLATFORM_PERMISSIONS)[number];\n"],
  ],
  "src/lib/platform/primary-owners.ts": [
    ["import \"server-only\";\nimport { eq, sql } from \"drizzle-orm\";\nimport { db, tenantPrimaryOwnersTable, type Tx } from \"@/db\";\nimport { isCustomerInviteAcceptanceEnabled } from \"./flags\";\n\n// ---------------------------------------------------------------------------------------------\n// Platform Owner PO-03A — a company's PRIMARY OWNER (tenant_primary_owners, PO-02D1A F5; decisions O-2, O-3).\n//\n//  • READ-ONLY. The one writer of a mapping is the PO-02D3 acceptance core (one insert, in the transaction that\n//    creates the company). Nothing transfers, backfills (O-2: legacy companies stay \"not designated\") or deletes one.\n//  • Consulted by exactly one customer module, src/lib/team/ownership-gate.ts (every Team change and the Team page),\n//    and by the Platform Owner read model (companies.ts) for the company detail.\n//  • Staged rollout (PO-03A §7). Whether the table exists is asked of the catalog, explicitly: to_regclass() on the\n//    UNQUALIFIED name resolves through the search_path exactly like the application's own queries. A missing TABLE is\n//    never inferred from a failing query, and a failing query is never read as a missing ROW — every error propagates\n//    and the caller fails closed.\n//      installed → every protected Team change is checked against the mapping, whatever any flag says;\n//      absent    → no mapping can exist here — unless a feature that CREATES mappings is switched on\n//                  (CUSTOMER_INVITE_ACCEPTANCE_ENABLED): the absence is then a deployment-order error and the gate\n//                  refuses every protected change.\n// ---------------------------------------------------------------------------------------------\n\ntype Executor = Tx | typeof db;\n\nexport type PrimaryOwnerFoundation = \"installed\" | \"absent\";\n\n/** The catalog's answer for the mapping table (an explicit fact, never derived from an error). */\nexport async function primaryOwnerFoundation(executor: Executor = db): Promise<PrimaryOwnerFoundation> {\n  const result = await executor.execute(sql`select to_regclass('tenant_primary_owners') is not null as present`);\n  const row = result.rows[0] as { present?: unknown } | undefined;\n  if (typeof row?.present !== \"boolean\") throw new Error(\"primary-owner foundation probe returned no answer\");\n  return row.present ? \"installed\" : \"absent\";\n}\n\n/** True while a feature that creates primary-owner mappings is switched on: the mapping table must then exist. */\nexport function primaryOwnerMappingsExpected(): boolean {\n  return isCustomerInviteAcceptanceEnabled();\n}\n\nexport type PrimaryOwnerMapping = { userId: number };\n\nfunction single(rows: { userId: number }[]): PrimaryOwnerMapping | null {\n  // org_id is the table's primary key: two rows mean the foundation is not what PO-02D1 installed — fail closed.\n  if (rows.length > 1) throw new Error(\"tenant_primary_owners holds more than one row for one company\");\n  return rows.length ? { userId: rows[0].userId } : null;\n}\n\n/**\n * Inside the caller's READ COMMITTED Team-change transaction, AFTER it has locked the company row and the affected\n * user rows (src/lib/team/member-changes.ts). FOR SHARE keeps the mapping from changing until the caller commits. The\n * order matters: the mapping's guard trigger locks the named user row FOR SHARE before it accepts a write, so a\n * mapping write that names a user this transaction holds either committed before the user-row lock was granted (and\n * is seen here — this statement takes a fresh snapshot) or waits for this transaction and then re-checks the user.\n */\nexport async function lockPrimaryOwnerMapping(tx: Tx, orgId: number): Promise<PrimaryOwnerMapping | null> {\n  if (!Number.isSafeInteger(orgId) || orgId <= 0) return null;\n  const rows = await tx.select({ userId: tenantPrimaryOwnersTable.userId }).from(tenantPrimaryOwnersTable).where(eq(tenantPrimaryOwnersTable.orgId, orgId)).limit(2).for(\"share\");\n  return single(rows);\n}\n\n/** The mapping as committed (no lock) — for displays only, never for a decision. */\nexport async function readPrimaryOwnerMapping(executor: Executor, orgId: number): Promise<PrimaryOwnerMapping | null> {\n  if (!Number.isSafeInteger(orgId) || orgId <= 0) return null;\n  const rows = await executor.select({ userId: tenantPrimaryOwnersTable.userId }).from(tenantPrimaryOwnersTable).where(eq(tenantPrimaryOwnersTable.orgId, orgId)).limit(2);\n  return single(rows);\n}\n",
      "import \"server-only\";\nimport { eq, inArray, sql } from \"drizzle-orm\";\nimport { db, tenantPrimaryOwnersTable, type Tx } from \"@/db\";\nimport { isCustomerInviteAcceptanceEnabled } from \"./flags\";\n\n// ---------------------------------------------------------------------------------------------\n// Platform Owner PO-03A — a company's PRIMARY OWNER (tenant_primary_owners, PO-02D1A F5; decisions O-2, O-3).\n//\n//  • READ-ONLY. The one writer of a mapping is the PO-02D3 acceptance core (one insert, in the transaction that\n//    creates the company). Nothing transfers, backfills (O-2: legacy companies stay \"not designated\") or deletes one.\n//  • Consulted by exactly one customer module, src/lib/team/ownership-gate.ts (every Team change and the Team page),\n//    and by the Platform Owner read model (companies.ts) for the company detail.\n//  • Staged rollout (PO-03A §7). Whether the table exists is asked of the catalog, explicitly: to_regclass() on the\n//    UNQUALIFIED name resolves through the search_path exactly like the application's own queries. A missing TABLE is\n//    never inferred from a failing query, and a failing query is never read as a missing ROW — every error propagates\n//    and the caller fails closed.\n//      installed → every protected Team change is checked against the mapping, whatever any flag says;\n//      absent    → no mapping can exist here — unless a feature that CREATES mappings is switched on\n//                  (CUSTOMER_INVITE_ACCEPTANCE_ENABLED): the absence is then a deployment-order error and the gate\n//                  refuses every protected change.\n// ---------------------------------------------------------------------------------------------\n\ntype Executor = Tx | typeof db;\n\nexport type PrimaryOwnerFoundation = \"installed\" | \"absent\";\n\n/** The catalog's answer for the mapping table (an explicit fact, never derived from an error). */\nexport async function primaryOwnerFoundation(executor: Executor = db): Promise<PrimaryOwnerFoundation> {\n  const result = await executor.execute(sql`select to_regclass('tenant_primary_owners') is not null as present`);\n  const row = result.rows[0] as { present?: unknown } | undefined;\n  if (typeof row?.present !== \"boolean\") throw new Error(\"primary-owner foundation probe returned no answer\");\n  return row.present ? \"installed\" : \"absent\";\n}\n\n/** True while a feature that creates primary-owner mappings is switched on: the mapping table must then exist. */\nexport function primaryOwnerMappingsExpected(): boolean {\n  return isCustomerInviteAcceptanceEnabled();\n}\n\nexport type PrimaryOwnerMapping = { userId: number };\n\nfunction single(rows: { userId: number }[]): PrimaryOwnerMapping | null {\n  // org_id is the table's primary key: two rows mean the foundation is not what PO-02D1 installed — fail closed.\n  if (rows.length > 1) throw new Error(\"tenant_primary_owners holds more than one row for one company\");\n  return rows.length ? { userId: rows[0].userId } : null;\n}\n\n/**\n * Inside the caller's READ COMMITTED Team-change transaction, AFTER it has locked the company row and the affected\n * user rows (src/lib/team/member-changes.ts). FOR SHARE keeps the mapping from changing until the caller commits. The\n * order matters: the mapping's guard trigger locks the named user row FOR SHARE before it accepts a write, so a\n * mapping write that names a user this transaction holds either committed before the user-row lock was granted (and\n * is seen here — this statement takes a fresh snapshot) or waits for this transaction and then re-checks the user.\n */\nexport async function lockPrimaryOwnerMapping(tx: Tx, orgId: number): Promise<PrimaryOwnerMapping | null> {\n  if (!Number.isSafeInteger(orgId) || orgId <= 0) return null;\n  const rows = await tx.select({ userId: tenantPrimaryOwnersTable.userId }).from(tenantPrimaryOwnersTable).where(eq(tenantPrimaryOwnersTable.orgId, orgId)).limit(2).for(\"share\");\n  return single(rows);\n}\n\n/** The mapping as committed (no lock) — for displays only, never for a decision. */\nexport async function readPrimaryOwnerMapping(executor: Executor, orgId: number): Promise<PrimaryOwnerMapping | null> {\n  if (!Number.isSafeInteger(orgId) || orgId <= 0) return null;\n  const rows = await executor.select({ userId: tenantPrimaryOwnersTable.userId }).from(tenantPrimaryOwnersTable).where(eq(tenantPrimaryOwnersTable.orgId, orgId)).limit(2);\n  return single(rows);\n}\n\n/**\n * PO-03B — the mapped primary owners of several companies as committed (no lock), for a directory page: ONE query,\n * company id → user id. Display only, never a decision. The caller asks primaryOwnerFoundation() first (an absent\n * table is \"not installed\", never an error turned into \"not designated\").\n */\nexport async function readPrimaryOwnerUserIds(executor: Executor, orgIds: number[]): Promise<Map<number, number>> {\n  const ids = [...new Set(orgIds.filter((id) => Number.isSafeInteger(id) && id > 0))];\n  if (!ids.length) return new Map();\n  const rows = await executor\n    .select({ orgId: tenantPrimaryOwnersTable.orgId, userId: tenantPrimaryOwnersTable.userId })\n    .from(tenantPrimaryOwnersTable)\n    .where(inArray(tenantPrimaryOwnersTable.orgId, ids));\n  const out = new Map<number, number>();\n  for (const r of rows) {\n    // org_id is the primary key: a repeated company means the foundation is not what PO-02D1 installed — fail closed.\n    if (out.has(r.orgId)) throw new Error(\"tenant_primary_owners holds more than one row for one company\");\n    out.set(r.orgId, r.userId);\n  }\n  return out;\n}\n"],
  ],
  "src/lib/platform/seat-accounting.ts": [
    ["import \"server-only\";\nimport { and, eq, isNull, sql } from \"drizzle-orm\";\nimport { db, subscriptionPackagesTable, subscriptionPackageVersionsTable, tenantSubscriptionsTable, usersTable, type Tx } from \"@/db\";\n\n// ---------------------------------------------------------------------------------------------\n// Platform Owner PO-03A — READ-ONLY user-seat accounting: THE one service that counts a company's seats.\n// Used by the customer Team page (through src/lib/team/ownership-gate.ts, for the session's own company only) and by\n// the Platform Owner company detail (companies.ts, behind platform.companies.read).\n//\n//  • Occupied seats = every customer user of the company, active AND disabled, plus pending customer-user invitations.\n//    Customer-user invitations do not exist yet (PO-00 M6), so that term is 0 — none is fabricated.\n//  • Allowance = the CURRENT subscription's immutable seats_snapshot (superseded_at IS NULL; at most one per company).\n//    Without a current subscription there is NO allowance: nothing is inferred from the package catalogue and no\n//    subscription is created (legacy and /register companies stay unsubscribed — Schema §11.7, decision R-2).\n//  • Display only. `enforced` is always false: nothing refuses, blocks or hides a user because of these numbers\n//    (enforcement is a later, separately approved phase — docs/platform-owner/PO03A_DEVELOPMENT.md §H.4).\n",
      "import \"server-only\";\nimport { and, eq, inArray, isNull, sql } from \"drizzle-orm\";\nimport { db, subscriptionPackagesTable, subscriptionPackageVersionsTable, tenantSubscriptionsTable, usersTable, type Tx } from \"@/db\";\n\n// ---------------------------------------------------------------------------------------------\n// Platform Owner PO-03A — READ-ONLY user-seat accounting: THE one service that counts a company's seats.\n// Used by the customer Team page (through src/lib/team/ownership-gate.ts, for the session's own company only), by\n// the Platform Owner company detail (companies.ts, behind platform.companies.read) and (PO-03B) by the Platform Owner\n// user directory (customer-users.ts, behind platform.users.read — readSeatAccountingForCompanies, the same rule).\n//\n//  • Occupied seats = every customer user of the company, active AND disabled, plus pending customer-user invitations.\n//    Customer-user invitations do not exist yet (PO-00 M6), so that term is 0 — none is fabricated.\n//  • Allowance = the CURRENT subscription's immutable seats_snapshot (superseded_at IS NULL; at most one per company).\n//    Without a current subscription there is NO allowance: nothing is inferred from the package catalogue and no\n//    subscription is created (legacy and /register companies stay unsubscribed — Schema §11.7, decision R-2).\n//  • Display only. `enforced` is always false: nothing refuses, blocks or hides a user because of these numbers\n//    (enforcement is a later, separately approved phase — docs/platform-owner/PO03A_DEVELOPMENT.md §H.4).\n"],
    ["  if (!row.s && !row.v && !row.p) return \"absent\";\n  return \"partial\";\n}\n\nconst sub = tenantSubscriptionsTable;\nconst ver = subscriptionPackageVersionsTable;\nconst pkg = subscriptionPackagesTable;\n\n/** The company's current subscription allowance as committed (no lock). */\nasync function currentAllowance(executor: Executor, orgId: number): Promise<SeatAllowance> {\n  const foundation = await subscriptionFoundation(executor);\n  if (foundation === \"absent\") return { state: \"not_installed\" };\n  // Only some of the tables: not what PO-02D1 installs (one transaction) — never guessed around.\n  if (foundation === \"partial\") throw new Error(\"the subscription foundation is only partly installed\");\n  const rows = await executor\n    .select({\n      seats: sub.seatsSnapshot,\n      isTrial: sub.isTrial,\n      cycle: sub.cycle,\n      lifecycleState: sub.lifecycleState,\n      startDate: sub.startDate,\n      endDate: sub.endDate,\n      versionNumber: ver.versionNumber,\n      packageName: pkg.name,\n    })\n    .from(sub)\n    .innerJoin(ver, eq(ver.id, sub.packageVersionId))\n    .innerJoin(pkg, eq(pkg.id, ver.packageId))\n    .where(and(eq(sub.orgId, orgId), isNull(sub.supersededAt)))\n    .limit(2);\n  // tenant_subscriptions_current_uq allows one current row per company: two mean a malformed foundation.\n  if (rows.length > 1) throw new Error(\"more than one current subscription for one company\");\n  const r = rows[0];\n  if (!r) return { state: \"none\" };\n  if (!Number.isSafeInteger(r.seats) || r.seats <= 0) throw new Error(\"the current subscription has no valid seats snapshot\");\n  return { state: \"assigned\", seats: r.seats, packageName: r.packageName, versionNumber: r.versionNumber, isTrial: r.isTrial, cycle: r.cycle, lifecycleState: r.lifecycleState, startDate: r.startDate, endDate: r.endDate };\n}\n\n/**\n * One company's seat accounting. The caller decides WHICH company: the customer gate passes the session's own\n * organization only; the platform read model passes the authorized company detail's id.\n */\nexport async function readSeatAccounting(executor: Executor, orgId: number): Promise<SeatAccounting> {\n  if (!Number.isSafeInteger(orgId) || orgId <= 0) throw new Error(\"readSeatAccounting: invalid organization id\");\n  const [counts] = await executor\n    .select({ total: sql<number>`count(*)::int`, active: sql<number>`(count(*) filter (where ${usersTable.isActive}))::int` })\n    .from(usersTable)\n    .where(eq(usersTable.orgId, orgId));\n  const allowance = await currentAllowance(executor, orgId);\n  return computeSeatAccounting(orgId, { total: Number(counts?.total ?? 0), active: Number(counts?.active ?? 0) }, 0, allowance);\n}\n",
      "  if (!row.s && !row.v && !row.p) return \"absent\";\n  return \"partial\";\n}\n\nconst sub = tenantSubscriptionsTable;\nconst ver = subscriptionPackageVersionsTable;\nconst pkg = subscriptionPackagesTable;\n\n// The allowance columns of a current subscription — one list for the single-company and the directory reads.\nconst ALLOWANCE_FIELDS = {\n  seats: sub.seatsSnapshot,\n  isTrial: sub.isTrial,\n  cycle: sub.cycle,\n  lifecycleState: sub.lifecycleState,\n  startDate: sub.startDate,\n  endDate: sub.endDate,\n  versionNumber: ver.versionNumber,\n  packageName: pkg.name,\n};\ntype AllowanceRow = { seats: number; isTrial: boolean; cycle: string; lifecycleState: string; startDate: string; endDate: string; versionNumber: number; packageName: string };\n\n/** A current subscription row → its allowance; a missing or non-positive seats snapshot is a malformed foundation. */\nfunction assignedAllowance(r: AllowanceRow): SeatAllowance {\n  if (!Number.isSafeInteger(r.seats) || r.seats <= 0) throw new Error(\"the current subscription has no valid seats snapshot\");\n  return { state: \"assigned\", seats: r.seats, packageName: r.packageName, versionNumber: r.versionNumber, isTrial: r.isTrial, cycle: r.cycle, lifecycleState: r.lifecycleState, startDate: r.startDate, endDate: r.endDate };\n}\n\n/** The company's current subscription allowance as committed (no lock). */\nasync function currentAllowance(executor: Executor, orgId: number): Promise<SeatAllowance> {\n  const foundation = await subscriptionFoundation(executor);\n  if (foundation === \"absent\") return { state: \"not_installed\" };\n  // Only some of the tables: not what PO-02D1 installs (one transaction) — never guessed around.\n  if (foundation === \"partial\") throw new Error(\"the subscription foundation is only partly installed\");\n  const rows = await executor\n    .select(ALLOWANCE_FIELDS)\n    .from(sub)\n    .innerJoin(ver, eq(ver.id, sub.packageVersionId))\n    .innerJoin(pkg, eq(pkg.id, ver.packageId))\n    .where(and(eq(sub.orgId, orgId), isNull(sub.supersededAt)))\n    .limit(2);\n  // tenant_subscriptions_current_uq allows one current row per company: two mean a malformed foundation.\n  if (rows.length > 1) throw new Error(\"more than one current subscription for one company\");\n  const r = rows[0];\n  if (!r) return { state: \"none\" };\n  return assignedAllowance(r);\n}\n\n/** PO-03B — the current allowances of several companies as committed (no lock): one probe and one query. */\nasync function currentAllowances(executor: Executor, orgIds: number[]): Promise<Map<number, SeatAllowance>> {\n  const foundation = await subscriptionFoundation(executor);\n  if (foundation === \"absent\") return new Map(orgIds.map((id) => [id, { state: \"not_installed\" } as SeatAllowance]));\n  if (foundation === \"partial\") throw new Error(\"the subscription foundation is only partly installed\");\n  const rows = await executor\n    .select({ orgId: sub.orgId, ...ALLOWANCE_FIELDS })\n    .from(sub)\n    .innerJoin(ver, eq(ver.id, sub.packageVersionId))\n    .innerJoin(pkg, eq(pkg.id, ver.packageId))\n    .where(and(inArray(sub.orgId, orgIds), isNull(sub.supersededAt)));\n  const out = new Map<number, SeatAllowance>(orgIds.map((id) => [id, { state: \"none\" } as SeatAllowance]));\n  const seen = new Set<number>();\n  for (const r of rows) {\n    if (seen.has(r.orgId)) throw new Error(\"more than one current subscription for one company\");\n    seen.add(r.orgId);\n    out.set(r.orgId, assignedAllowance(r));\n  }\n  return out;\n}\n\n/**\n * One company's seat accounting. The caller decides WHICH company: the customer gate passes the session's own\n * organization only; the platform read model passes the authorized company detail's id.\n */\nexport async function readSeatAccounting(executor: Executor, orgId: number): Promise<SeatAccounting> {\n  if (!Number.isSafeInteger(orgId) || orgId <= 0) throw new Error(\"readSeatAccounting: invalid organization id\");\n  const [counts] = await executor\n    .select({ total: sql<number>`count(*)::int`, active: sql<number>`(count(*) filter (where ${usersTable.isActive}))::int` })\n    .from(usersTable)\n    .where(eq(usersTable.orgId, orgId));\n  const allowance = await currentAllowance(executor, orgId);\n  return computeSeatAccounting(orgId, { total: Number(counts?.total ?? 0), active: Number(counts?.active ?? 0) }, 0, allowance);\n}\n\n/**\n * PO-03B — the seat accounting of several companies at once, for the Platform Owner user directory: the same rule\n * (computeSeatAccounting), a fixed number of queries whatever the page size (counts, the foundation probe, the\n * allowances). Display only; the caller passes the companies of the rows it is showing.\n */\nexport async function readSeatAccountingForCompanies(executor: Executor, orgIds: number[]): Promise<Map<number, SeatAccounting>> {\n  const ids = [...new Set(orgIds.filter((id) => Number.isSafeInteger(id) && id > 0))];\n  if (!ids.length) return new Map();\n  const counts = await executor\n    .select({ orgId: usersTable.orgId, total: sql<number>`count(*)::int`, active: sql<number>`(count(*) filter (where ${usersTable.isActive}))::int` })\n    .from(usersTable)\n    .where(inArray(usersTable.orgId, ids))\n    .groupBy(usersTable.orgId);\n  const allowances = await currentAllowances(executor, ids);\n  const byOrg = new Map(counts.map((c) => [c.orgId, c]));\n  return new Map(\n    ids.map((orgId) => {\n      const c = byOrg.get(orgId);\n      return [orgId, computeSeatAccounting(orgId, { total: Number(c?.total ?? 0), active: Number(c?.active ?? 0) }, 0, allowances.get(orgId) ?? { state: \"none\" })];\n    }),\n  );\n}\n"],
