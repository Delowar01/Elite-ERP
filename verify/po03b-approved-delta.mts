er\": { en: \"Never\", ar: \"لم يسجّل الدخول بعد\" },\n  \"cu.seatsNoAllowance\": { en: \"{occupied} · no subscription\", ar: \"{occupied} · بدون اشتراك\" },\n  \"cu.seatsOver\": { en: \"Over by {n}\", ar: \"تجاوز بمقدار {n}\" },\n  \"cu.seatsUnknown\": { en: \"Unavailable\", ar: \"غير متاح\" },\n  \"cu.pageOf\": { en: \"Page {page} of {pages}\", ar: \"الصفحة {page} من {pages}\" },\n  \"cu.noneMatch\": { en: \"No users match these filters.\", ar: \"لا يوجد مستخدمون يطابقون عوامل التصفية هذه.\" },\n  \"cu.empty\": { en: \"No customer users yet.\", ar: \"لا يوجد مستخدمون للعملاء بعد.\" },\n  \"cu.emptyHint\": { en: \"Users appear here when a company registers or adds team members.\", ar: \"يظهر المستخدمون هنا عند تسجيل شركة أو إضافة أعضاء إلى فريقها.\" },\n  \"cu.companyFilter\": { en: \"Showing the users of {company}\", ar: \"عرض مستخدمي {company}\" },\n  \"cu.allCompanies\": { en: \"Show every company\", ar: \"عرض جميع الشركات\" },\n  \"cu.seatNote\": { en: \"Seat usage is display only: seat limits are not enforced.\", ar: \"استخدام المقاعد للعرض فقط: لا يُطبَّق حد المقاعد.\" },\n  \"cu.privacyNote\": { en: \"Only account details are shown. Passwords, two-factor secrets, recovery codes and session tokens never leave the server.\", ar: \"تُعرض بيانات الحساب الأساسية فقط، ولا تغادر كلمات المرور وأسرار المصادقة الثنائية ورموز الاسترداد ورموز الجلسات الخادمَ أبدًا.\" },\n  \"cu.back\": { en: \"Back to users\", ar: \"العودة إلى المستخدمين\" },\n  \"cu.account\": { en: \"Account\", ar: \"الحساب\" },\n  \"cu.fieldName\": { en: \"Name\", ar: \"الاسم\" },\n  \"cu.fieldEmail\": { en: \"Email\", ar: \"البريد الإلكتروني\" },\n  \"cu.fieldReference\": { en: \"User reference\", ar: \"مرجع المستخدم\" },\n  \"cu.fieldCompany\": { en: \"Company\", ar: \"الشركة\" },\n  \"cu.fieldRole\": { en: \"Role\", ar: \"الدور\" },\n  \"cu.fieldStatus\": { en: \"Status\", ar: \"الحالة\" },\n  \"cu.fieldMfa\": { en: \"Two-factor authentication\", ar: \"المصادقة الثنائية\" },\n  \"cu.fieldLastSignIn\": { en: \"Last recorded sign-in\", ar: \"آخر تسجيل دخول مسجّل\" },\n  \"cu.fieldCreated\": { en: \"Account created\", ar: \"تاريخ إنشاء الحساب\" },\n  \"cu.fieldSessions\": { en: \"Active sessions\", ar: \"الجلسات النشطة\" },\n  \"cu.fieldPrimary\": { en: \"Primary owner\", ar: \"المالك الرئيسي\" },\n  \"cu.primaryYes\": { en: \"Yes, the company's primary owner\", ar: \"نعم، المالك الرئيسي للشركة\" },\n  \"cu.primaryNo\": { en: \"No\", ar: \"لا\" },\n  \"cu.primaryNotInstalled\": { en: \"Not recorded in this environment\", ar: \"غير مسجّل في هذه البيئة\" },\n  \"cu.primaryUnavailable\": { en: \"Unavailable right now\", ar: \"غير متاح حاليًا\" },\n  \"cu.companySeats\": { en: \"Company seats\", ar: \"مقاعد الشركة\" },\n  \"cu.createdOn\": { en: \"Account created {date}\", ar: \"أُنشئ الحساب في {date}\" },\n  \"cu.controls\": { en: \"Account controls\", ar: \"التحكم في الحساب\" },\n  \"cu.disable\": { en: \"Disable user\", ar: \"تعطيل المستخدم\" },\n  \"cu.enable\": { en: \"Enable user\", ar: \"تفعيل المستخدم\" },\n  \"cu.revoke\": { en: \"Sign out everywhere\", ar: \"تسجيل الخروج من جميع الأجهزة\" },\n  \"cu.protectedPrimary\": { en: \"The company's primary owner can't be disabled.\", ar: \"لا يمكن تعطيل المالك الرئيسي للشركة.\" },\n  \"cu.protectedLast\": { en: \"This is the company's last active owner, so the account can't be disabled.\", ar: \"هذا آخر مالك نشط في الشركة، لذا لا يمكن تعطيل الحساب.\" },\n  \"cu.protectionUnknown\": { en: \"Owner protection can't be checked right now, so the account can't be disabled.\", ar: \"يتعذّر التحقق من حماية المالك حاليًا، لذا لا يمكن تعطيل الحساب.\" },\n  \"cu.noSessions\": { en: \"This user has no active sessions.\", ar: \"لا توجد جلسات نشطة لهذا المستخدم.\" },\n  \"cu.controlsNote\": { en: \"Each action needs a reason and a fresh code from your authenticator app, and is recorded in the platform audit trail and in the company's security log.\", ar: \"يتطلب كل إجراء ذكر السبب ورمزًا جديدًا من تطبيق المصادقة، ويُسجَّل في سجل تدقيق المنصة وفي سجل أمان الشركة.\" },\n  \"cu.limitsNote\": { en: \"Signing in as the user, resetting passwords, changing roles and transferring ownership are not available here.\", ar: \"لا يتوفر هنا تسجيل الدخول بحساب المستخدم أو إعادة تعيين كلمات المرور أو تغيير الأدوار أو نقل الملكية.\" },\n  \"cu.dataKeptNote\": { en: \"Disabling an account never deletes or changes the company's data.\", ar: \"لا يحذف تعطيل الحساب بيانات الشركة ولا يغيّرها أبدًا.\" },\n  \"cuDialog.disableTitle\": { en: \"Disable {name}?\", ar: \"هل تريد تعطيل {name}؟\" },\n  \"cuDialog.enableTitle\": { en: \"Enable {name}?\", ar: \"هل تريد تفعيل {name}؟\" },\n  \"cuDialog.revokeTitle\": { en: \"Sign {name} out everywhere?\", ar: \"هل تريد تسجيل خروج {name} من جميع الأجهزة؟\" },\n  \"cuDialog.disableText\": { en: \"The user is signed out at once and can't sign in until the account is enabled again.\", ar: \"يُسجَّل خروج المستخدم فورًا ولا يمكنه تسجيل الدخول حتى يُعاد تفعيل الحساب.\" },\n  \"cuDialog.enableText\": { en: \"The user can sign in again with their existing password and two-factor settings.\", ar: \"يمكن للمستخدم تسجيل الدخول مجددًا بكلمة المرور وإعدادات المصادقة الثنائية الحالية.\" },\n  \"cuDialog.revokeText\": { en: \"Every active session of this user ends now. The account stays active.\", ar: \"تنتهي جميع الجلسات النشطة لهذا المستخدم الآن، ويبقى الحساب نشطًا.\" },\n  \"cuDialog.sessionsNow\": { en: \"Active sessions right now: {n}\", ar: \"الجلسات النشطة الآن: {n}\" },\n  \"cuDialog.disableEnds\": { en: \"All of the user's active sessions end at once.\", ar: \"تنتهي جميع جلسات المستخدم النشطة فورًا.\" },\n  \"cuDialog.disableNoSignIn\": { en: \"Sign-in is refused while the account is disabled.\", ar: \"يُرفض تسجيل الدخول ما دام الحساب معطّلًا.\" },\n  \"cuDialog.dataKept\": { en: \"The company's records, including everything this user created, are kept unchanged.\", ar: \"تبقى سجلات الشركة، بما فيها كل ما أنشأه هذا المستخدم، دون تغيير.\" },\n  \"cuDialog.seatsUnchanged\": { en: \"The account still occupies a company seat. Seat limits are not enforced.\", ar: \"يظل الحساب يشغل مقعدًا في الشركة، ولا يُطبَّق حد المقاعد.\" },\n  \"cuDialog.recorded\": { en: \"The platform audit trail records your name and reason. The company's security log shows only that a platform operator made the change.\", ar: \"يسجّل سجل تدقيق المنصة اسمك والسبب، ولا يظهر في سجل أمان الشركة إلا أن أحد مشغّلي المنصة أجرى التغيير.\" },\n  \"cuDialog.enableEnds\": { en: \"Any session left over from before is ended, so the user signs in again.\", ar: \"تُنهى أي جلسة متبقية من قبل، ليسجّل المستخدم الدخول من جديد.\" },\n  \"cuDialog.revokeSignIn\": { en: \"The user can sign in again. To stop new sign-ins, disable the account instead.\", ar: \"يمكن للمستخدم تسجيل الدخول مجددًا. ولإيقاف تسجيلات الدخول الجديدة، عطّل الحساب بدلًا من ذلك.\" },\n  \"cuDialog.checking\": { en: \"Checking the account's current state…\", ar: \"جارٍ التحقق من الحالة الحالية للحساب…\" },\n  \"cuDialog.changed\": { en: \"This account changed after this page was loaded. Refresh to see its current state before deciding.\", ar: \"تغيّر هذا الحساب بعد تحميل هذه الصفحة. حدّث الصفحة لرؤية حالته الحالية قبل اتخاذ القرار.\" },\n  \"cuDialog.disableSubmit\": { en: \"Disable user\", ar: \"تعطيل المستخدم\" },\n  \"cuDialog.enableSubmit\": { en: \"Enable user\", ar: \"تفعيل المستخدم\" },\n  \"cuDialog.revokeSubmit\": { en: \"End sessions\", ar: \"إنهاء الجلسات\" },\n  \"cuDialog.disabling\": { en: \"Disabling…\", ar: \"جارٍ التعطيل…\" },\n  \"cuDialog.enabling\": { en: \"Enabling…\", ar: \"جارٍ التفعيل…\" },\n  \"cuDialog.revoking\": { en: \"Ending sessions…\", ar: \"جارٍ إنهاء الجلسات…\" },\n  \"cuDialog.disabledDone\": { en: \"The account is disabled. Sessions ended: {n}.\", ar: \"عُطّل الحساب. الجلسات المنتهية: {n}.\" },\n  \"cuDialog.enabledDone\": { en: \"The account is enabled. The user can sign in again.\", ar: \"فُعّل الحساب. يمكن للمستخدم تسجيل الدخول مجددًا.\" },\n  \"cuDialog.revokedDone\": { en: \"Sessions ended: {n}. The account stays active.\", ar: \"الجلسات المنتهية: {n}. ويبقى الحساب نشطًا.\" },\n  \"event.userViewed\": { en: \"Viewed the account\", ar: \"عرض الحساب\" },\n  \"event.userDisabled\": { en: \"Disabled the account\", ar: \"عطّل الحساب\" },\n  \"event.userEnabled\": { en: \"Enabled the account\", ar: \"فعّل الحساب\" },\n  \"event.userSessionsRevoked\": { en: \"Ended the user's sessions\", ar: \"أنهى جلسات المستخدم\" },\n  \"event.userDisableRejected\": { en: \"Disable attempt refused\", ar: \"رُفضت محاولة التعطيل\" },\n  \"event.userEnableRejected\": { en: \"Enable attempt refused\", ar: \"رُفضت محاولة التفعيل\" },\n  \"event.userRevokeRejected\": { en: \"Session revocation refused\", ar: \"رُفض إنهاء الجلسات\" },\n  \"cu.activity\": { en: \"Platform Owner activity\", ar: \"نشاط مالك المنصة\" },\n  \"cu.activityNone\": { en: \"No Platform Owner activity for this account yet.\", ar: \"لا يوجد نشاط لمالك المنصة على هذا الحساب بعد.\" },\n  \"cu.activityNote\": { en: \"The latest {n} Platform Owner actions on this account. The customer's own activity stays in their ERP.\", ar: \"آخر {n} إجراءً لمالك المنصة على هذا الحساب، ويبقى نشاط العميل نفسه في نظامه.\" },\n  \"cu.auditDownTitle\": { en: \"This account can't be shown right now\", ar: \"يتعذّر عرض هذا الحساب حاليًا\" },\n  \"cu.auditDownText\": { en: \"Opening a customer account is recorded in the audit trail, and that record couldn't be written, so nothing is shown. Try again later.\", ar: \"يُسجَّل فتح حساب العميل في سجل التدقيق، وتعذّرت كتابة هذا السجل، لذا لم يُعرض شيء. حاول مرة أخرى لاحقًا.\" },\n  \"cu.notFoundTitle\": { en: \"User not found\", ar: \"المستخدم غير موجود\" },\n  \"cu.notFoundText\": { en: \"This customer user doesn't exist, or the link is incorrect.\", ar: \"مستخدم العميل هذا غير موجود، أو أن الرابط غير صحيح.\" },\n  \"cu.viewAudited\": { en: \"Opening this page is recorded in the platform audit trail.\", ar: \"يُسجَّل فتح هذه الصفحة في سجل تدقيق المنصة.\" },\n} as const satisfies