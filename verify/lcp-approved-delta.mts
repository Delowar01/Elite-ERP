    ["\n@media (min-width: 1024px) and (max-width: 1279.98px) {\n  /* Tablet: always the compact rail, from the first paint (sidebar.tsx switches the content after\n     hydration). The collapse toggle is hidden — there is nothing to expand to at this width. */\n  .sidebar { width: 66px; padding-inline: var(--space-8); }\n  .sidebar .sidebar-toggle,\n  .sidebar .sidebar-brand-text,\n  .sidebar .sidebar-product,\n  .sidebar .nav-divider { display: none; }\n  .sidebar .sidebar-head { flex-direction: column; gap: var(--space-8); padding-inline: 0; }\n  .sidebar .sidebar-brand { justify-content: center; gap: 0; }\n  .sidebar .sidebar-logo-img { height: 28px; }\n  .sidebar .nav-item { justify-content: center; padding-inline: 0; gap: 0; }\n  .sidebar .nav-item-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n",
      "@media (min-width: 1024px) {\n  .app-main-inner { padding: var(--space-32); }\n"],
    ["  .sidebar { display: none; }\n  .topbar-menu-btn { display: flex; }\n  .topbar .topbar-search { display: none; }\n  .topbar-search-icon { display: flex; }\n  .topbar { padding-inline: var(--space-16); }\n  .app-main { padding: var(--space-20) var(--space-16); }\n",
      "  /* Avatar only; the name and role stay in the account menu (LCP: the name block from lg). */\n  .topbar-utilities .topbar-profile-text { display: none; }\n}\n\n@media (min-width: 768px) and (max-width: 1023.98px) {\n  /* Tablet: always the 68px mini rail, from the first paint (sidebar.tsx switches the content after\n     hydration). The collapse toggle is hidden — there is nothing to expand to at this width. */\n  .sidebar { width: 68px; }\n  .sidebar .sidebar-toggle,\n  .sidebar .sidebar-org-text,\n  .sidebar .nav-divider { display: none; }\n  .sidebar .nav-list { padding-inline: var(--space-8); gap: var(--space-4); }\n  .sidebar .nav-group + .nav-group { border-block-start: 1px solid var(--sidebar-border); padding-block-start: var(--space-8); }\n  .sidebar .nav-item { justify-content: center; width: 40px; height: 40px; min-height: 40px; margin-inline: auto; padding-inline: 0; gap: 0; }\n  .sidebar .nav-item-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n  .sidebar .sidebar-footer { padding: var(--space-8); align-items: center; }\n  .sidebar .sidebar-org { padding: 0; background: transparent; justify-content: center; }\n}\n\n@media (max-width: 767.98px) {\n  .sidebar { display: none; }\n  .topbar-menu-btn { display: flex; }\n  /* Beside the menu button and, from 640px, the utilities, the row has no room for the search field: the compact\n     search entry stands in for it (LCP md), it and the command-menu pill keep their size, and the organization\n     name alone gives way (it truncates) rather than push the bar past the viewport or under its neighbours. */\n  .topbar-brand { margin-inline-end: 0; flex-shrink: 1; }\n  .topbar .topbar-search { display: none; }\n  .topbar .topbar-search-icon { display: flex; }\n  .topbar-search-slot { flex: 0 0 auto; }\n"],
