  "src/app/globals.css": [
    ["   NAVY COMMAND DESIGN TOKENS (DEV-UI-01.1)\n",
      "   ELITE ERP × LEAD CAPTURE PRO DESIGN TOKENS (LCP design adoption; structure from DEV-UI-01.1)\n"],
    ["   Direction (owner decisions D-02…D-04): dark navy structure, light restrained work area, SOLID\n   colours only, navy primary actions with white text, orange as accent / focus / active marker.\n   The Mockup V12 contract (mockup-parity.css) is superseded (D-01).\n",
      "   Values: the Lead Capture Pro WEB palette resolved from its HSL triplets to HEX (the LCP kit's\n   `--primary: 24 100% 50%` form is NOT valid for a registered <color>, so it is never pasted here),\n   adapted where a value fails WCAG — see docs/design-system/ERP_LCP_TOKEN_MAP.md. Supersedes the\n   Navy Command palette by the owner's LCP direction; the token NAMES and the single-block structure\n   are unchanged, so every consumer and the per-org theme engine re-skin without a second system.\n"],
    ["@property --badge-text { syntax: \"<color>\"; inherits: true; initial-value: transparent; }\n\n",
      "@property --badge-text { syntax: \"<color>\"; inherits: true; initial-value: transparent; }\n/* LCP shell: the dark 56px application header (LCP `--sidebar` surface) and its parts. */\n@property --header-bg { syntax: \"<color>\"; inherits: true; initial-value: transparent; }\n@property --header-ink { syntax: \"<color>\"; inherits: true; initial-value: transparent; }\n@property --header-ink-muted { syntax: \"<color>\"; inherits: true; initial-value: transparent; }\n@property --header-border { syntax: \"<color>\"; inherits: true; initial-value: transparent; }\n@property --header-accent { syntax: \"<color>\"; inherits: true; initial-value: transparent; }\n@property --shadow-color-soft { syntax: \"<color>\"; inherits: true; initial-value: transparent; }\n@property --brand-ink { syntax: \"<color>\"; inherits: true; initial-value: transparent; }\n\n"],
    ["\n  /* ---- canonical semantic tokens ---- */\n  --canvas: light-dark(#f5f6f8, #090b17);\n  --surface: light-dark(#ffffff, #171b31);\n  --surface-subtle: light-dark(#eef0f4, #1e2239);\n  --surface-raised: light-dark(#ffffff, #20253f);\n  --text: light-dark(#17173f, #eceef7);\n  --text-muted: light-dark(#555a75, #a9aecb);\n  --text-faint: light-dark(#646982, #959bbb);\n  --border: light-dark(#e2e5eb, #2b3050);\n  --border-strong: light-dark(#c9ced8, #3c4268);\n  --border-control: light-dark(#868ca3, #646b8f);\n  --primary: light-dark(#1b1b4e, #5a60d6);\n",
      "  /* The Elite lockup on the page surface: brand navy in light, the page ink in dark. */\n  --brand-ink: light-dark(#1b1b4e, #f9fafb);\n\n  /* ---- canonical semantic tokens (LCP web palette, resolved; adaptations in the token map) ---- */\n  --canvas: light-dark(#f9fafb, #1a1a1a);\n  --surface: light-dark(#ffffff, #272727);\n  --surface-subtle: light-dark(#f3f4f6, #333333);\n  --surface-raised: light-dark(#ffffff, #2b2b2b);\n  --text: light-dark(#212121, #f9fafb);\n  --text-muted: light-dark(#676f7e, #9da3af);\n  --text-faint: light-dark(#676f7e, #9da3af);\n  --border: light-dark(#e2e4e9, #363636);\n  --border-strong: light-dark(#cbcfd7, #454545);\n  --border-control: light-dark(#878e9b, #7a7a7a);\n  --primary: light-dark(#f06000, #ff6600);\n"],
    ["  --primary-hover: light-dark(#2b2c6e, #4e54c8);\n  --accent: light-dark(#e87722, #f0924a);\n  --accent-foreground: light-dark(#17173f, #17173f);\n  --accent-ink: light-dark(#a9500c, #f5a868);\n  --accent-tint: light-dark(#fdf0e6, #3a2615);\n  --focus: light-dark(#c55f0e, #f0924a);\n  --link: light-dark(#1b1b4e, #a9b0ff);\n  --success: light-dark(#17734a, #5fcf9a);\n  --success-bg: light-dark(#e3f2ea, #13301f);\n  --warning: light-dark(#8a5a00, #f0c060);\n  --warning-bg: light-dark(#fbf0d9, #33270a);\n  --danger: light-dark(#b4322d, #f08a83);\n  --danger-bg: light-dark(#fbe6e4, #3a1716);\n",
      "  --primary-hover: light-dark(#e65c00, #ff7b24);\n  --accent: light-dark(#f06000, #ff6600);\n  --accent-foreground: light-dark(#ffffff, #ffffff);\n  --accent-ink: light-dark(#b84900, #ff6600);\n  --accent-tint: light-dark(#fff0e5, #3d220f);\n  --focus: light-dark(#f06000, #ff6600);\n  --link: light-dark(#b84900, #ff6600);\n  --success: light-dark(#157f3c, #24c25e);\n  --success-bg: light-dark(#ebfaf0, #153220);\n  --warning: light-dark(#9f5704, #fbbd23);\n  --warning-bg: light-dark(#fef5dc, #342714);\n  --danger: light-dark(#c52020, #f87171);\n  --danger-bg: light-dark(#feecec, #371515);\n"],
    ["  --danger-hover: light-dark(#992b26, #f29c96);\n  --info: light-dark(#2f4fb8, #93a6f0);\n  --info-bg: light-dark(#e7ecfa, #19203f);\n",
      "  --danger-hover: light-dark(#a71b1b, #f98686);\n  --info: light-dark(#0a5adb, #61a6fa);\n  --info-bg: light-dark(#e6f1fe, #152337);\n"],
    ["  --neutral: light-dark(#4f546e, #b3b7cf);\n  --neutral-bg: light-dark(#eceef3, #232741);\n  --disabled-background: light-dark(#eceef2, #1f2338);\n  --disabled-text: light-dark(#6b6f86, #9a9fbd);\n",
      "  --neutral: light-dark(#676f7e, #9da3af);\n  --neutral-bg: light-dark(#f3f4f6, #333333);\n  --disabled-background: light-dark(#f3f4f6, #2e2e2e);\n  --disabled-text: light-dark(#7c8494, #8c8c8c);\n"],
    ["  /* ---- type families ---- */\n  /* Latin UI → IBM Plex Sans; Arabic glyphs fall through to IBM Plex Sans Arabic (Plex Sans ships no\n     Arabic), so mixed Arabic/English text uses each script's intended face. Plex Mono is for codes,\n     IDs and hashes ONLY — money uses the UI face with tabular figures. */\n  --font-ui: var(--font-body-raw), var(--font-arabic-raw), system-ui, sans-serif;\n  --font-code-family: var(--font-mono-raw), ui-monospace, monospace;\n",
      "  /* ---- LCP shell surfaces ----\n     The application header is the LCP `--sidebar` surface: LCP navy hsl(233 28% 14%) in light, the\n     charcoal hsl(0 0% 13%) in dark; its border is hsl(233 28% 10%) / the dark hairline, its accent\n     (search field, hover) hsl(233 28% 20%) / hsl(0 0% 20%). Ink is the LCP foreground #F9FAFB. */\n  --header-bg: light-dark(#1a1c2e, #212121);\n  --header-ink: light-dark(#f9fafb, #f9fafb);\n  --header-border: light-dark(#121421, #2e2e2e);\n  --header-accent: light-dark(#252841, #333333);\n  /* Muted header ink: the header ink at 76% over the header surface, resolved to HEX like every other\n     colour here (9.73:1 / 9.41:1 on the header, 8.34:1 / 7.39:1 on its accent). */\n  --header-ink-muted: light-dark(#c3c5ca, #c5c6c7);\n  --header-hover-bg: var(--header-accent);\n  --header-height: 56px;\n"],
    ["  /* ---- elevation: borders lead, shadows are restrained ---- */\n  --shadow-color: light-dark(rgba(23, 23, 63, 0.06), rgba(0, 0, 0, 0.35));\n  --shadow-overlay-color: light-dark(rgba(16, 15, 50, 0.22), rgba(0, 0, 0, 0.6));\n  --shadow-sm: 0 1px 2px var(--shadow-color);\n  --shadow-overlay: 0 12px 32px -8px var(--shadow-overlay-color);\n  --focus-ring: light-dark(rgba(197, 95, 14, 0.35), rgba(240, 146, 74, 0.5));\n",
      "  /* ---- type families: in their own `:root, .print-root` block right after this one ---- */\n\n  /* ---- elevation: the shadow scale LCP actually renders (Tailwind v4 defaults; its declared flat\n     --shadow-* values are dead in the reference product). Dark mode deepens the shadow colour. ---- */\n  --shadow-color: light-dark(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.45));\n  --shadow-color-soft: light-dark(rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.3));\n  --shadow-overlay-color: light-dark(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.5));\n  --shadow-xs: 0 1px 2px 0 var(--shadow-color-soft);\n  --shadow-sm: 0 1px 3px 0 var(--shadow-color), 0 1px 2px -1px var(--shadow-color);\n  --shadow-md: 0 4px 6px -1px var(--shadow-color), 0 2px 4px -2px var(--shadow-color);\n  --shadow-overlay: 0 10px 15px -3px var(--shadow-overlay-color), 0 4px 6px -4px var(--shadow-overlay-color);\n  --focus-ring: light-dark(rgba(240, 96, 0, 0.35), rgba(255, 102, 0, 0.5));\n\n  /* ---- motion (LCP): 120 / 180 / 280ms; the global reduced-motion rule collapses all of it ---- */\n  --motion-fast: 120ms;\n  --motion-base: 180ms;\n  --motion-slow: 280ms;\n  --motion-ease: cubic-bezier(0.2, 0, 0, 1);\n"],
    ["  --radius: 8px;\n",
      "  --radius: 8px; /* LCP --radius .5rem: sm 4 · md 6 (controls) · lg 8 · xl 12 (cards) */\n"],
    ["  /* Font aliases used by legacy CSS. Plus Jakarta Sans is retired (display → UI face). Mono stays a\n     REAL code face (DEV-UI-01.1-C1): --font-mono is IBM Plex Mono for codes, IDs and hashes. Numeric\n     data (money, prices, rates, quantities, balances, percentages, dates) uses the UI face with\n     tabular figures via --font-numeric / the `num-tabular` utility — never by redefining Mono. */\n  --font-body: var(--font-ui);\n  --font-display: var(--font-ui);\n  --font-mono: var(--font-code-family);\n  --font-numeric: var(--font-ui);\n",
      "  /* Font aliases used by legacy CSS: in the type-families block below, with the families they point at. */\n"],
    ["  --brand-orange-light: light-dark(#f5a25c, #f8b57c);\n  --chart-navy: light-dark(#1b1b4e, #8c90e0);\n",
      "  --brand-orange-light: light-dark(#ff8533, #ff9e5c);\n  /* LCP chart-2: navy hsl(233 28% 40%) / hsl(233 28% 60%). */\n  --chart-navy: light-dark(#495083, #7c83b6);\n"],
    ["  --input-background: light-dark(#ffffff, #1e2239);\n",
      "  --input-background: light-dark(#ffffff, #333333);\n"],
    ["  --accent-hover: light-dark(#cf6414, #f4a76b);\n",
      "  --accent-hover: light-dark(#e65c00, #ff7b24);\n"],
    ["  /* Application frame (DEV-UI-01.3, D-01.3-A): a navy sidebar in BOTH appearances — brand navy in\n     light, the deeper brand navy in dark. Its text is the approved light ink (white / the dark-mode\n     text value); muted text, borders, hover and the selected tint are mixes of those approved colours,\n     so no new palette is introduced. `--sidebar-active-bg` is kept for the org theme engine, which\n     still writes it; the shell paints the selected state from the tint + indicator below, both of\n     which follow the org's Selected-item colour (`--selected-item-background`). */\n  --sidebar-bg: light-dark(var(--brand-navy), var(--brand-navy-deep));\n  --sidebar-ink: light-dark(#ffffff, #eceef7);\n  --sidebar-ink-muted: color-mix(in srgb, var(--sidebar-ink) 72%, var(--sidebar-bg));\n",
      "  /* Application frame (LCP shell, supersedes DEV-UI-01.3 D-01.3-A): the sidebar is the LIGHT card\n     surface under the dark header — LCP `bg-card border-e` — in both appearances: the card colour, the\n     body / muted ink, the hairline, the subtle hover fill. The selected item is the solid org\n     Selected-item fill (LCP `bg-primary text-primary-foreground shadow-sm`), so the org theme engine's\n     injected `.nav-item.active` rule and the shell paint the same pair. `--sidebar-active-bg` is kept\n     for that engine, which still writes it. */\n  --sidebar-bg: var(--surface);\n  --sidebar-ink: var(--text);\n  --sidebar-ink-muted: var(--text-muted);\n"],
    ["  --sidebar-border: color-mix(in srgb, var(--sidebar-ink) 14%, var(--sidebar-bg));\n  --sidebar-hover-bg: color-mix(in srgb, var(--sidebar-ink) 9%, var(--sidebar-bg));\n  --sidebar-selected-tint: color-mix(in srgb, var(--selected-item-background) 22%, var(--sidebar-bg));\n  --sidebar-indicator: var(--selected-item-background);\n  /* Uploaded organisation logos are designed for white paper; they sit on a white plate on the rail. */\n",
      "  --sidebar-border: var(--border);\n  --sidebar-hover-bg: var(--surface-subtle);\n  /* Uploaded organisation logos are designed for white paper; they sit on a white plate (LCP\n     `bg-white/95 p-0.5`) on the dark header and in the sidebar footer. */\n"],
    ["  --shadow-card-hover: var(--shadow-sm);\n  --shadow-glass: var(--shadow-overlay);\n  --ring-orange: 0 0 0 3px var(--focus-ring);\n}\n\n:root[data-theme=\"light\"] {\n",
      "  --shadow-card-hover: var(--shadow-sm);\n  --shadow-glass: var(--shadow-overlay);\n  --ring-orange: 0 0 0 3px var(--focus-ring);\n}\n\n/* ---- type families ----\n   Latin UI → Inter 400–700 (the LCP face, self-hosted by next/font); Arabic glyphs fall through to IBM\n   Plex Sans Arabic (Inter ships no Arabic), so mixed Arabic/English text uses each script's intended face.\n   Plex Mono is for codes, IDs and hashes ONLY — money uses the UI face with tabular figures.\n   Declared on the root AND re-resolved on .print-root: the print / PDF document binds --font-body-raw to\n   its own frozen face (IBM Plex Sans 400–600, --font-print-raw — the pre-LCP face), so a printed or PDF\n   document never changes with the UI face: one definition, two bindings. The legacy aliases sit here with\n   the families they point at, so they re-resolve on the print root too: Plus Jakarta Sans is retired\n   (display → UI face); --font-mono stays a REAL code face (DEV-UI-01.1-C1); numeric data (money, prices,\n   rates, quantities, balances, percentages, dates) uses the UI face with tabular figures via\n   --font-numeric / the `num-tabular` utility — never by redefining Mono. */\n:root,\n.print-root {\n  --font-ui: var(--font-body-raw), var(--font-arabic-raw), system-ui, sans-serif;\n  --font-code-family: var(--font-mono-raw), ui-monospace, monospace;\n  --font-body: var(--font-ui);\n  --font-display: var(--font-ui);\n  --font-mono: var(--font-code-family);\n  --font-numeric: var(--font-ui);\n}\n.print-root {\n  --font-body-raw: var(--font-print-raw);\n}\n\n:root[data-theme=\"light\"] {\n"],
    ["   plain @theme (not inline) so the Arabic line heights below can re-point the same variables. */\n",
      "   plain @theme (not inline) so the Arabic line heights below can re-point the same variables.\n   LCP adoption: the steps keep their names and are re-pointed to the LCP / Tailwind sizes — body and\n   controls 14/20 (LCP text-sm, so `body` and `body-lg` now share a size), title 18/28 (text-lg),\n   display 30/36 (text-3xl). Mirrored by TYPE_SCALE in src/lib/design-tokens.ts. */\n"],
    ["  --text-body: 13px;\n",
      "  --text-body: 14px;\n"],
    ["  --text-title--line-height: 26px;\n",
      "  --text-title--line-height: 28px;\n"],
    ["  --text-display--line-height: 38px;\n",
      "  --text-display--line-height: 36px;\n"],
    ["  --text-body--line-height: 22px;\n",
      "  --text-body--line-height: 24px;\n"],
    ["  --text-title-sm--line-height: 26px;\n  --text-title--line-height: 28px;\n  --text-page--line-height: 32px;\n",
      "  --text-title-sm--line-height: 26px;\n  --text-title--line-height: 30px;\n  --text-page--line-height: 32px;\n"],
    ["  /* Approved radius family: 4 · 6 · 8 · 12. */\n",
      "  /* LCP shell colours as utilities (bg-header, text-header-ink …). */\n  --color-header: var(--header-bg);\n  --color-header-ink: var(--header-ink);\n  --color-header-border: var(--header-border);\n  --color-header-accent: var(--header-accent);\n\n  /* Approved radius family: 4 · 6 · 8 · 12 (= LCP rounded-sm / md / lg / xl). */\n"],
    ["  line-height: var(--text-body-lg--line-height);\n  /* Figures line up in every table, total and KPI without a monospace face. */\n  font-variant-numeric: tabular-nums;\n}\n\n/* Arabic: no uppercase, no Latin-style tracking — letter-spacing breaks Arabic joining. Applied to\n",
      "  line-height: var(--text-body-lg--line-height);\n  /* Figures line up in every table, total and KPI without a monospace face. */\n  font-variant-numeric: tabular-nums;\n}\n\n/* Print / PDF output is frozen (LCP adoption): Chromium paints the document canvas into the PDF wherever the\n   A4 page does not cover it (the page edge, a long document's last page), so the print route keeps the\n   pre-LCP canvas exactly — light #f5f6f8, dark #090b17 — and its PDFs stay identical. App pages never match. */\nbody:has(> .print-root) {\n  background: light-dark(#f5f6f8, #090b17);\n}\n\n/* Arabic: no uppercase, no Latin-style tracking — letter-spacing breaks Arabic joining. Applied to\n"],
    ["/* Status tag (DEV-UI-01.2, owner decision D-13) — rendered ONLY by <StatusBadge>, from the status\n   registry. A restrained 4px enterprise tag: semantic foreground on its tint, no leading dot, no\n   gradient, glow or lift. Logical padding, so it reads correctly in RTL. Generic `.pill` / <Badge>\n   (Default, document type, access level …) is deliberately NOT changed by this class. */\n",
      "/* Status pill (DEV-UI-01.2 registry; LCP shape, decision D-LCP-6 superseding D-13) — rendered ONLY by\n   <StatusBadge>, from the status registry. The LCP `StatusBadge` recipe: a soft rounded-full pill, the\n   semantic foreground on its tint, a hairline in the tone at 25%, and a leading 6px dot in the\n   foreground (LCP `dot`) — unless the tag already leads with an icon or the registry's pulse indicator,\n   which take the dot's place. Decorative only: the label carries the meaning, so the dot is a\n   pseudo-element (never read). No gradient, glow or lift. Logical padding, so it reads correctly in\n   RTL. Generic `.pill` / <Badge> (Default, document type, access level …) is deliberately NOT changed\n   by this class. */\n"],
    ["  padding-block: 2px;\n  padding-inline: 8px;\n  border-radius: 4px;\n  font-size: var(--text-caption);\n  line-height: var(--text-caption--line-height);\n",
      "  padding-block: 1px;\n  padding-inline: 9px;\n  border-radius: 9999px;\n  border: 1px solid color-mix(in srgb, var(--status-fg) 25%, transparent);\n  font-size: var(--text-body-sm);\n  line-height: var(--text-body-sm--line-height);\n"],
    ["  background: var(--status-bg);\n}\n.status-tag[data-tone=\"neutral\"] { --status-fg: var(--neutral); --status-bg: var(--neutral-bg); }\n.status-tag[data-tone=\"info\"] { --status-fg: var(--info); --status-bg: var(--info-bg); }\n",
      "  background: var(--status-bg);\n}\n.status-tag::before {\n  content: \"\";\n  width: 6px;\n  height: 6px;\n  border-radius: 9999px;\n  background: currentColor;\n  flex-shrink: 0;\n}\n.status-tag:has(> svg, > .status-tag-pulse)::before { content: none; }\n.status-tag[data-tone=\"neutral\"] { --status-fg: var(--neutral); --status-bg: var(--neutral-bg); }\n.status-tag[data-tone=\"info\"] { --status-fg: var(--info); --status-bg: var(--info-bg); }\n"],
