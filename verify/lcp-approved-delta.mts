      "/* ---- sidebar (LCP SidebarNav on the card surface; its own sticky, scrolling column) ---- */\n.sidebar {\n  width: 256px;\n  flex-shrink: 0;\n  position: sticky;\n  top: var(--header-height);\n  height: calc(100vh - var(--header-height));\n  align-self: flex-start;\n  display: flex;\n  flex-direction: column;\n  overflow-y: auto;\n  background: var(--sidebar-bg);\n  color: var(--sidebar-ink);\n  border-inline-end: 1px solid var(--sidebar-border);\n  transition: width 0.15s ease;\n}\n\n/* ---- navigation list (sidebar and sheet: nav-list.tsx) ---- */\n.nav-list { display: flex; flex-direction: column; gap: var(--space-12); padding: var(--space-12); }\n.nav-group, .nav-group-items { display: flex; flex-direction: column; gap: var(--space-2); }\n\n.nav-item {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: var(--space-12);\n  min-height: var(--control-height);\n  padding-inline: var(--space-12);\n  border-radius: 8px;\n  font-size: var(--text-body);\n  line-height: var(--text-body--line-height);\n  font-weight: 500;\n  color: var(--sidebar-ink-muted);\n  text-decoration: none;\n  transition: background-color 0.15s ease, color 0.15s ease;\n}\n.nav-item svg { flex-shrink: 0; }\n.nav-item-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.nav-item:not(.active):hover { background: var(--sidebar-hover-bg); color: var(--sidebar-ink); }\n\n/* Selected (LCP, D-LCP-4): the solid org Selected-item fill with its contrast-validated foreground and\n   the LCP shadow-sm, plus aria-current — the same pair the org theme engine injects for\n   `.nav-item.active`, so every org's colour drives it. Distinguishable without colour: the fill, the\n   weight 600 and the shadow. */\n.nav-list .nav-item.active {\n  background: var(--selected-item-background);\n  color: var(--selected-item-text);\n  font-weight: 600;\n  box-shadow: var(--shadow-sm);\n}\n\n/* Group header (LCP: 11px, semibold, uppercase, wider tracking; Arabic drops case and tracking via\n   the global rule). Muted ink at full strength — LCP's 70% muted is below 4.5:1. */\n.nav-divider {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  background: transparent;\n  border: none;\n  cursor: pointer;\n  font-size: var(--text-caption);\n  line-height: var(--text-caption--line-height);\n  font-weight: 600;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  color: var(--sidebar-ink-muted);\n  padding-block: var(--space-6);\n  padding-inline: var(--space-12);\n  border-radius: 6px;\n}\n.nav-divider:hover { color: var(--sidebar-ink); }\n.nav-divider-chevron { flex-shrink: 0; transition: transform 0.15s ease; }\n.nav-divider-chevron.is-collapsed { transform: rotate(-90deg); }\n/* A rotation has no logical form: the collapsed chevron points toward the inline end. */\n[dir=\"rtl\"] .nav-divider-chevron.is-collapsed { transform: rotate(90deg); }\n\n/* Keyboard focus in the navigation: the approved focus colour, drawn inside the item so the scrolling\n   column never clips it. */\n.nav-list :is(.nav-item, .nav-divider):focus-visible,\n.sidebar-toggle:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }\n\n/* ---- sidebar footer (LCP SidebarFooter: organization card + collapse control) ---- */\n.sidebar-footer {\n  position: sticky;\n  bottom: 0;\n  margin-block-start: auto;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-8);\n  padding: var(--space-12);\n  background: var(--sidebar-bg);\n  border-block-start: 1px solid var(--sidebar-border);\n}\n.sidebar-org {\n  display: flex;\n  align-items: center;\n  gap: var(--space-8);\n  min-width: 0;\n  padding: var(--space-8);\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--surface-subtle) 60%, transparent);\n}\n.sidebar-org-text { min-width: 0; }\n.sidebar-org-name { font-size: var(--text-body); line-height: var(--text-body--line-height); font-weight: 600; color: var(--sidebar-ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.sidebar-org-product { font-size: var(--text-caption); line-height: var(--text-caption--line-height); color: var(--sidebar-ink-muted); }\n.sidebar-toggle {\n  display: flex;\n  align-items: center;\n  gap: var(--space-8);\n  width: 100%;\n  height: 32px;\n  padding-inline: var(--space-12);\n  border: none;\n  border-radius: 8px;\n  background: transparent;\n  color: var(--sidebar-ink-muted);\n  font-size: var(--text-body-sm);\n  line-height: var(--text-body-sm--line-height);\n  font-weight: 500;\n  cursor: pointer;\n  transition: background-color 0.15s ease, color 0.15s ease;\n}\n.sidebar-toggle:hover { background: var(--sidebar-hover-bg); color: var(--sidebar-ink); }\n\n/* ---- mini rail (LCP 68px): icons only; labels stay in the accessibility tree and as the native\n   tooltip; groups are separated by a hairline instead of headers ---- */\n.sidebar:is(.collapsed, [data-rail]) { width: 68px; }\n.sidebar:is(.collapsed, [data-rail]) .nav-list { padding-inline: var(--space-8); gap: var(--space-4); }\n.sidebar:is(.collapsed, [data-rail]) .nav-group + .nav-group { border-block-start: 1px solid var(--sidebar-border); padding-block-start: var(--space-8); }\n.sidebar:is(.collapsed, [data-rail]) .nav-item { justify-content: center; width: 40px; height: 40px; min-height: 40px; margin-inline: auto; padding-inline: 0; gap: 0; }\n.sidebar:is(.collapsed, [data-rail]) .nav-item-label {\n  position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;\n}\n.sidebar:is(.collapsed, [data-rail]) .sidebar-footer { padding: var(--space-8); align-items: center; }\n.sidebar:is(.collapsed, [data-rail]) .sidebar-org { padding: 0; background: transparent; justify-content: center; }\n.sidebar:is(.collapsed, [data-rail]) .sidebar-toggle { width: 40px; height: 40px; padding-inline: 0; justify-content: center; }\n\n/* ---- navigation sheet (< 768: LCP left Sheet, w-72, the sidebar's own surface) ---- */\n"],
