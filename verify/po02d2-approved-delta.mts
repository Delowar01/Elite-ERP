const h16 = (s: string) => createHash("sha256").update(s).digest("hex").slice(0, 16);

/** A file's text with the PO-02D2 hunks undone — 1cbbbc1's text when they are its only change; any other file as it is. */
export function undoPo02d2(file: string, text: string): string {
  return (PO02D2_EDITS[file] ?? []).reduce((acc, [was, is]) => acc.replace(is, () => was), text);
}
/** Files whose bytes are not 1cbbbc1's plus exactly the recorded hunks, and added files not as recorded. */
export function po02d2Drift(actual: (file: string) => string | null): string[] {
  const drift: string[] = [];
  for (const [f, hunks] of Object.entries(PO02D2_EDITS)) {
    const src = actual(f);
    if (src === null || !hunks.every(([was, is]) => src.split(is).length === 2 && !src.includes(was)) || h16(undoPo02d2(f, src)) !== PO02D2_BASE_SHA[f]) drift.push(f);
  }
  for (const [f, sha] of Object.entries(PO02D2_NEW)) {
    const src = actual(f);
    if (src === null || h16(src) !== sha) drift.push(`new: ${f}`);
  }
  return drift;
}
